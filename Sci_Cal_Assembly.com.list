[2154]        :                                       ;=====================================================================
[2155]        :                                       ; SCIENTIFIC CALCULATOR ADDITIONS
[2156]        :                                       ; These routines are integrated into main_loop and calculate below.
[2157]        :                                       ; Two-number operators: g = GCD, l = LCM, o = MOD.
[2158]        :                                       ; One-number keys: b = absolute value, f = Fibonacci, z = prime test,
[2159]        :                                       ; h = hexadecimal display, i = binary display, u = cube root,
[2160]        :                                       ; j = log10, w = log2, v = random 0..99, % = integer percent,
[2161]        :                                       ; d = sine, y = cosine, t = tangent (trig answers are scaled by 1000).
[2162]        :                                       ; The keypad log and trigonometry buttons are connected to implemented keys.
[2163]        :                                       ;=====================================================================
[2164]        :                                       
[2165]        :                                       ;---------------- extra key dispatcher ----------------
[2166]    14FC:                                       ml_more:                      ; reached when the key was not a digit and not an old key
[2167]    14FC: 3C 67                                 cmp al, 'g'               ; is it g (GCD)?
[2168]    14FE: 75 03                                 jne mm_n01                ; no: try the next one
[2169]    1500: E9 C0 EC                              jmp do_op                 ; yes: treat it as an operator (do_op calls press_operator)
[2170]    1503:                                       mm_n01:
[2171]    1503: 3C 6C                                 cmp al, 'l'               ; is it l (LCM)?
[2172]    1505: 75 03                                 jne mm_n02                ; no: try the next one
[2173]    1507: E9 B9 EC                              jmp do_op                 ; yes: operator
[2174]    150A:                                       mm_n02:
[2175]    150A: 3C 6F                                 cmp al, 'o'               ; is it o (MOD)?
[2176]    150C: 75 03                                 jne mm_n03                ; no: try the next one
[2177]    150E: E9 B2 EC                              jmp do_op                 ; yes: operator
[2178]    1511:                                       mm_n03:
[2179]    1511: 3C 62                                 cmp al, 'b'               ; is it b (absolute value)?
[2180]    1513: 75 06                                 jne mm_n04                ; no: try the next one
[2181]    1515: E8 3F 01                              call press_abs            ; do it
[2182]    1518: E9 0E EC                              jmp main_loop             ; wait for the next key
[2183]    151B:                                       mm_n04:
[2184]    151B: 3C 66                                 cmp al, 'f'               ; is it f (Fibonacci)?
[2185]    151D: 75 06                                 jne mm_n05                ; no: try the next one
[2186]    151F: E8 4C 01                              call press_fib            ; do it
[2187]    1522: E9 04 EC                              jmp main_loop             ; wait for the next key
[2188]    1525:                                       mm_n05:
[2189]    1525: 3C 7A                                 cmp al, 'z'               ; is it z (prime test)?
[2190]    1527: 75 06                                 jne mm_n06                ; no: try the next one
[2191]    1529: E8 6E 01                              call press_prime          ; do it
[2192]    152C: E9 FA EB                              jmp main_loop             ; wait for the next key
[2193]    152F:                                       mm_n06:
[2194]    152F: 3C 68                                 cmp al, 'h'               ; is it h (hex)?
[2195]    1531: 75 06                                 jne mm_n07                ; no: try the next one
[2196]    1533: E8 92 01                              call press_hex            ; do it
[2197]    1536: E9 F0 EB                              jmp main_loop             ; wait for the next key
[2198]    1539:                                       mm_n07:
[2199]    1539: 3C 69                                 cmp al, 'i'               ; is it i (binary)?
[2200]    153B: 75 06                                 jne mm_n08                ; no: try the next one
[2201]    153D: E8 BA 01                              call press_bin            ; do it
[2202]    1540: E9 E6 EB                              jmp main_loop             ; wait for the next key
[2203]    1543:                                       mm_n08:
[2204]    1543: 3C 75                                 cmp al, 'u'               ; is it u (cube root)?
[2205]    1545: 75 06                                 jne mm_n09                ; no: try the next one
[2206]    1547: E8 DB 01                              call press_cbrt           ; do it
[2207]    154A: E9 DC EB                              jmp main_loop             ; wait for the next key
[2208]    154D:                                       mm_n09:
[2209]    154D: 3C 6A                                 cmp al, 'j'               ; is it j (log10)?
[2210]    154F: 75 06                                 jne mm_n10                ; no: try the next one
[2211]    1551: E8 FD 01                              call press_log10          ; do it
[2212]    1554: E9 D2 EB                              jmp main_loop             ; wait for the next key
[2213]    1557:                                       mm_n10:
[2214]    1557: 3C 77                                 cmp al, 'w'               ; is it w (log2)?
[2215]    1559: 75 06                                 jne mm_n11                ; no: try the next one
[2216]    155B: E8 17 02                              call press_log2           ; do it
[2217]    155E: E9 C8 EB                              jmp main_loop             ; wait for the next key
[2218]    1561:                                       mm_n11:
[2219]    1561: 3C 76                                 cmp al, 'v'               ; is it v (random)?
[2220]    1563: 75 06                                 jne mm_n12                ; no: try the next one
[2221]    1565: E8 39 02                              call press_rand           ; do it
[2222]    1568: E9 BE EB                              jmp main_loop             ; wait for the next key
[2223]    156B:                                       mm_n12:
[2224]    156B: 3C 25                                 cmp al, '%'               ; is it % (divide by 100)?
[2225]    156D: 75 06                                 jne mm_n13                ; no: try the next one
[2226]    156F: E8 22 02                              call press_percent        ; do it
[2227]    1572: E9 B4 EB                              jmp main_loop             ; wait for the next key
[2228]    1575:                                       mm_n13:
[2229]    1575: 3C 64                                 cmp al, 'd'               ; is it d (sin)?
[2230]    1577: 75 06                                 jne mm_n14                ; no: try the next one
[2231]    1579: E8 89 02                              call press_sin            ; do it
[2232]    157C: E9 AA EB                              jmp main_loop             ; wait for the next key
[2233]    157F:                                       mm_n14:
[2234]    157F: 3C 79                                 cmp al, 'y'               ; is it y (cos)?
[2235]    1581: 75 06                                 jne mm_n15                ; no: try the next one
[2236]    1583: E8 89 02                              call press_cos            ; do it
[2237]    1586: E9 A0 EB                              jmp main_loop             ; wait for the next key
[2238]    1589:                                       mm_n15:
[2239]    1589: 3C 74                                 cmp al, 't'               ; is it t (tan)?
[2240]    158B: 75 03                                 jne mm_end                ; no: it is a key we do not know
