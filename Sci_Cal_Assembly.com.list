[ 430]    0506: FE C6                                 inc dh                    ; one row down (middle row)
[ 431]    0508: 8A 16 D7 14                           mov dl, [b_col]           ; column of the box again
[ 432]    050C: E8 19 01                              call set_cursor           ; go to the left wall
[ 433]    050F: B0 B3                                 mov al, 0B3h              ; left wall
[ 434]    0511: E8 1B 01                              call put_char             ; print it
