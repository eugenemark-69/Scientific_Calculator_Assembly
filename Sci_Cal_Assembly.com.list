[2246]    1593:                                       do_more2 proc                 ; same rules as do_more: DL = 0 other, 1 = AX holds answer, 2 = error
[2247]    1593: 80 3E EE 14 67                        cmp byte ptr [op], 'g'    ; GCD?
[2248]    1598: 75 07                                 jne dm2_n1                ; no: try the next one
[2249]    159A: E8 39 00                              call do_gcd               ; AX = gcd(first, cur)
[2250]    159D: 72 24                                 jc dm2_error              ; carry set: error
[2251]    159F: EB 1F                                 jmp dm2_ok                ; done
[2252]    15A1:                                       dm2_n1:
[2253]    15A1: 80 3E EE 14 6C                        cmp byte ptr [op], 'l'    ; LCM?
[2254]    15A6: 75 07                                 jne dm2_n2                ; no: try the next one
[2255]    15A8: E8 4C 00                              call do_lcm               ; AX = lcm(first, cur)
[2256]    15AB: 72 16                                 jc dm2_error              ; carry set: error
[2257]    15AD: EB 11                                 jmp dm2_ok                ; done
[2258]    15AF:                                       dm2_n2:
[2259]    15AF: 80 3E EE 14 6F                        cmp byte ptr [op], 'o'    ; MOD?
[2260]    15B4: 75 07                                 jne dm2_other             ; no: it is not one of ours
[2261]    15B6: E8 7F 00                              call do_mod               ; AX = first mod cur
[2262]    15B9: 72 08                                 jc dm2_error              ; carry set: error
[2263]    15BB: EB 03                                 jmp dm2_ok                ; done
[2264]    15BD:                                       dm2_other:
[2265]    15BD: B2 00                                 mov dl, 0                 ; not one of g l o (this is the old dm_other code)
[2266]    15BF: C3                                    ret                       ; back
[2267]    15C0:                                       dm2_ok:
[2268]    15C0: B2 01                                 mov dl, 1                 ; AX holds the answer
[2269]    15C2: C3                                    ret                       ; back
[2270]    15C3:                                       dm2_error:
[2271]    15C3: B2 02                                 mov dl, 2                 ; there was an error
[2272]    15C5: C3                                    ret                       ; back
[2273]        :                                       do_more2 endp
