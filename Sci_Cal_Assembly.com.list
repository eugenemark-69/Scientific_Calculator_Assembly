[2062]    1230: B4 09                                 mov ah, 9                 ; DOS job 9: print text
[2063]    1232: CD 21                                 int 21h                   ; wipe the old number
[2064]    1234: 8A 1E D8 14                           mov bl, [len]             ; BL = number of digits
