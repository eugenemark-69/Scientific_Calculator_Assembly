[ 564]    0636:                                       add_digit proc                ; AL = the digit character
[ 565]    0636: 53                                    push bx                   ; keep the caller's registers safe
[ 566]    0637: 51                                    push cx
[ 567]    0638: 52                                    push dx
[ 568]    0639: 80 3E EF 14 00                        cmp byte ptr [fresh], 0   ; is the display showing an old number?
[ 569]    063E: 74 15                                 je ad_go                  ; no: continue the current entry
[ 570]    0640: C6 06 EF 14 00                        mov byte ptr [fresh], 0   ; yes: start a new number
[ 571]    0645: C6 06 D8 14 00                        mov byte ptr [len], 0     ; no digits yet
[ 572]    064A: C6 06 D9 14 24                        mov byte ptr [buf], '$'   ; empty text
[ 573]    064F: C7 06 EA 14 00 00                     mov word ptr [cur], 0     ; number = 0
[ 574]    0655:                                       ad_go:
[ 575]    0655: 8A 1E D8 14                           mov bl, [len]             ; BL = digits typed so far
[ 576]    0659: 80 FB 01                              cmp bl, 1                 ; exactly one digit?
[ 577]    065C: 75 14                                 jne ad_check              ; no: skip the leading-zero check
[ 578]    065E: 80 3E D9 14 30                        cmp byte ptr [buf], '0'   ; is that digit a zero?
[ 579]    0663: 75 0D                                 jne ad_check              ; no: keep it
[ 580]    0665: B3 00                                 mov bl, 0                 ; yes: replace that zero
[ 581]    0667: C6 06 D8 14 00                        mov byte ptr [len], 0     ; entry is now empty
[ 582]    066C: C7 06 EA 14 00 00                     mov word ptr [cur], 0     ; reset the numeric value too
[ 583]    0672:                                       ad_check:
[ 584]    0672: 80 FB 05                              cmp bl, 5                 ; at most five digits are allowed
[ 585]    0675: 73 3C                                 jae ad_done               ; full: ignore this key
[ 586]    0677: 2C 30                                 sub al, '0'               ; character -> numeric digit
[ 587]    0679: B4 00                                 mov ah, 0                 ; AX = digit from 0 to 9
[ 588]    067B: 8B C8                                 mov cx, ax                ; keep the digit in CX
[ 589]    067D: A1 EA 14                              mov ax, [cur]             ; AX = number typed so far
[ 590]    0680: BA 0A 00                              mov dx, 10                ; multiply old value by ten
[ 591]    0683: F7 E2                                 mul dx                    ; DX:AX = old value * 10
[ 592]    0685: 83 FA 00                              cmp dx, 0                 ; did multiplication exceed 16 bits?
[ 593]    0688: 75 26                                 jne ad_error              ; yes: outside the supported range
[ 594]    068A: 03 C1                                 add ax, cx                ; append the new digit
[ 595]    068C: 3D FF 7F                              cmp ax, 7FFFh             ; is it greater than 32767?
[ 596]    068F: 77 1F                                 ja ad_error               ; yes: show an error instead of wrapping
[ 597]    0691: A3 EA 14                              mov [cur], ax             ; save the checked number
[ 598]    0694: 8A C1                                 mov al, cl                ; get the digit again
[ 599]    0696: 04 30                                 add al, '0'               ; numeric digit -> character
[ 600]    0698: B7 00                                 mov bh, 0                 ; BX = current text position
[ 601]    069A: 88 87 D9 14                           mov [buf+bx], al          ; store the character
[ 602]    069E: FE C3                                 inc bl                    ; one more digit
[ 603]    06A0: 88 1E D8 14                           mov [len], bl             ; save the new length
[ 604]    06A4: B7 00                                 mov bh, 0                 ; make BX a clean buffer index
[ 605]    06A6: C6 87 D9 14 24                        mov byte ptr [buf+bx], '$'; keep the text ending with $
[ 606]    06AB: E8 78 0B                              call show_entry           ; redraw the display
[ 607]    06AE: EB 03                                 jmp ad_done               ; finish normally
[ 608]    06B0:                                       ad_error:
[ 609]    06B0: E8 A0 01                              call show_error           ; value is outside the supported range
[ 610]    06B3:                                       ad_done:
[ 611]    06B3: 5A                                    pop dx                    ; restore registers
[ 612]    06B4: 59                                    pop cx
[ 613]    06B5: 5B                                    pop bx
[ 614]    06B6: C3                                    ret                       ; back
[ 615]        :                                       add_digit endp
[ 616]    06B7:                                       del_digit proc                ; removes the last typed digit
[ 617]    06B7: 80 3E EF 14 00                        cmp byte ptr [fresh], 0   ; is the display showing a finished value?
[ 618]    06BC: 75 27                                 jne dd_done               ; then there is nothing typed to delete
[ 619]    06BE: 8A 1E D8 14                           mov bl, [len]             ; BL = digits typed
[ 620]    06C2: 80 FB 00                              cmp bl, 0                 ; nothing typed?
[ 621]    06C5: 74 1E                                 je dd_done                ; then nothing to delete
[ 622]    06C7: FE CB                                 dec bl                    ; one digit fewer
[ 623]    06C9: B7 00                                 mov bh, 0                 ; BX = BL
[ 624]    06CB: C6 87 D9 14 24                        mov byte ptr [buf+bx], '$'; the text now ends here
[ 625]    06D0: 88 1E D8 14                           mov [len], bl             ; save the new length
[ 626]    06D4: A1 EA 14                              mov ax, [cur]             ; AX = the number
[ 627]    06D7: BA 00 00                              mov dx, 0                 ; clear DX (it takes part in the division)
[ 628]    06DA: B9 0A 00                              mov cx, 10                ; CX = 10
[ 629]    06DD: F7 F1                                 div cx                    ; AX = AX / 10 (drops the last digit)
[ 630]    06DF: A3 EA 14                              mov [cur], ax             ; save it
[ 631]    06E2: E8 41 0B                              call show_entry           ; redraw the display
[ 632]    06E5:                                       dd_done:
[ 633]    06E5: C3                                    ret                       ; back
