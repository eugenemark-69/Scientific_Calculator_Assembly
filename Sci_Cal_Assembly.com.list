[2369]        :                                       ;---------------- one-number keys ----------------
[2370]    1657:                                       press_abs proc                ; b: absolute value
[2371]    1657: A1 EA 14                              mov ax, [cur]             ; AX = the current number
[2372]    165A: 3D 00 00                              cmp ax, 0                 ; negative?
[2373]    165D: 7D 07                                 jge pab_ok                ; no: nothing to change
[2374]    165F: F7 D8                                 neg ax                    ; flip the sign
[2375]    1661: 3D 00 80                              cmp ax, 8000h             ; was it -32768? (it cannot be flipped)
[2376]    1664: 74 04                                 je pab_error              ; yes: error
[2377]    1666:                                       pab_ok:
[2378]    1666: E8 DB F1                              call show_value           ; show it
[2379]    1669: C3                                    ret                       ; back
[2380]    166A:                                       pab_error:
[2381]    166A: E8 E6 F1                              call show_error           ; show E
[2382]    166D: C3                                    ret                       ; back
[2383]        :                                       press_abs endp
[2384]        :                                       
[2385]    166E:                                       press_fib proc                ; f: Fibonacci number n (n = 0 to 23)
[2386]    166E: 8B 0E EA 14                           mov cx, [cur]             ; CX = n
[2387]    1672: 83 F9 00                              cmp cx, 0                 ; below zero?
[2388]    1675: 7C 1F                                 jl pfi_error              ; yes: error
[2389]    1677: 83 F9 17                              cmp cx, 23                ; above 23? (F24 does not fit in a signed number)
[2390]    167A: 7F 1A                                 jg pfi_error              ; yes: error
[2391]    167C: B8 00 00                              mov ax, 0                 ; AX = the older number (F0 = 0)
[2392]    167F: BB 01 00                              mov bx, 1                 ; BX = the newer number (F1 = 1)
[2393]    1682:                                       pfi_loop:
[2394]    1682: 83 F9 00                              cmp cx, 0                 ; any steps left?
[2395]    1685: 74 0B                                 je pfi_done               ; no: AX holds F(n)
[2396]    1687: 8B D0                                 mov dx, ax                ; DX = older
[2397]    1689: 03 D3                                 add dx, bx                ; DX = older + newer = the next number
[2398]    168B: 8B C3                                 mov ax, bx                ; the newer one becomes the older one
[2399]    168D: 8B DA                                 mov bx, dx                ; the sum becomes the newer one
[2400]    168F: 49                                    dec cx                    ; one step fewer
[2401]    1690: EB F0                                 jmp pfi_loop              ; repeat
[2402]    1692:                                       pfi_done:
[2403]    1692: E8 AF F1                              call show_value           ; show it
[2404]    1695: C3                                    ret                       ; back
[2405]    1696:                                       pfi_error:
[2406]    1696: E8 BA F1                              call show_error           ; show E
[2407]    1699: C3                                    ret                       ; back
[2408]        :                                       press_fib endp
[2409]        :                                       
[2410]    169A:                                       press_prime proc              ; z: shows 1 when the number is prime, otherwise 0
[2411]    169A: 8B 1E EA 14                           mov bx, [cur]             ; BX = the number to test
[2412]    169E: 83 FB 02                              cmp bx, 2                 ; below 2?
[2413]    16A1: 7C 1E                                 jl ppr_no                 ; yes: not prime
[2414]    16A3: B9 02 00                              mov cx, 2                 ; CX = the divisor we try
[2415]    16A6:                                       ppr_loop:
[2416]    16A6: 8B C1                                 mov ax, cx                ; AX = divisor
