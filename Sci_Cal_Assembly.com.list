[2275]    15C6:                                       gcd_core proc                 ; AX and BX = two positive numbers (unsigned) -> AX = their GCD
[2276]    15C6:                                       gc_loop:
[2277]    15C6: 83 FB 00                              cmp bx, 0                 ; is the second number 0?
[2278]    15C9: 74 0A                                 je gc_done                ; yes: AX holds the answer
[2279]    15CB: 33 D2                                 xor dx, dx                ; clear DX before dividing
[2280]    15CD: F7 F3                                 div bx                    ; DX = AX mod BX
[2281]    15CF: 8B C3                                 mov ax, bx                ; the old second number becomes the first
[2282]    15D1: 8B DA                                 mov bx, dx                ; the remainder becomes the second
[2283]    15D3: EB F1                                 jmp gc_loop               ; repeat (Euclid's method)
[2284]    15D5:                                       gc_done:
[2285]    15D5: C3                                    ret                       ; back
[2286]        :                                       gcd_core endp
[2287]        :                                       
[2288]    15D6:                                       do_gcd proc                   ; AX = gcd(first, cur). Carry flag = error
[2289]    15D6: A1 EC 14                              mov ax, [first]           ; AX = first number
[2290]    15D9: 3D 00 00                              cmp ax, 0                 ; negative?
[2291]    15DC: 7D 02                                 jge dg_a                  ; no: keep it
[2292]    15DE: F7 D8                                 neg ax                    ; yes: GCD ignores the sign
[2293]    15E0:                                       dg_a:
[2294]    15E0: 8B 1E EA 14                           mov bx, [cur]             ; BX = second number
[2295]    15E4: 83 FB 00                              cmp bx, 0                 ; negative?
[2296]    15E7: 7D 02                                 jge dg_b                  ; no: keep it
[2297]    15E9: F7 DB                                 neg bx                    ; yes: GCD ignores the sign
[2298]    15EB:                                       dg_b:
[2299]    15EB: E8 D8 FF                              call gcd_core             ; AX = the GCD
[2300]    15EE: 3D FF 7F                              cmp ax, 7FFFh             ; too big to be a signed number?
[2301]    15F1: 77 02                                 ja dg_error               ; yes: error (only happens for -32768)
[2302]    15F3: F8                                    clc                       ; carry = 0: no error
[2303]    15F4: C3                                    ret                       ; back
[2304]    15F5:                                       dg_error:
[2305]    15F5: F9                                    stc                       ; carry = 1: there was an error
[2306]    15F6: C3                                    ret                       ; back
[2307]        :                                       do_gcd endp
[2308]        :                                       
[2309]    15F7:                                       do_lcm proc                   ; AX = lcm(first, cur). Carry flag = error
[2310]    15F7: A1 EC 14                              mov ax, [first]           ; AX = first number
[2311]    15FA: 3D 00 00                              cmp ax, 0                 ; negative?
[2312]    15FD: 7D 02                                 jge lc_a                  ; no: keep it
[2313]    15FF: F7 D8                                 neg ax                    ; yes: make it positive
[2314]    1601:                                       lc_a:
[2315]    1601: 8B 1E EA 14                           mov bx, [cur]             ; BX = second number
[2316]    1605: 83 FB 00                              cmp bx, 0                 ; negative?
[2317]    1608: 7D 02                                 jge lc_b                  ; no: keep it
[2318]    160A: F7 DB                                 neg bx                    ; yes: make it positive
[2319]    160C:                                       lc_b:
[2320]    160C: 3D 00 00                              cmp ax, 0                 ; is the first number 0?
[2321]    160F: 74 20                                 je lc_zero                ; yes: the answer is 0
[2322]    1611: 83 FB 00                              cmp bx, 0                 ; is the second number 0?
[2323]    1614: 74 1B                                 je lc_zero                ; yes: the answer is 0
[2324]    1616: 50                                    push ax                   ; keep the first number
[2325]    1617: 53                                    push bx                   ; keep the second number
[2326]    1618: E8 AB FF                              call gcd_core             ; AX = gcd (this destroys AX, BX and DX)
[2327]    161B: 8B C8                                 mov cx, ax                ; CX = the gcd
[2328]    161D: 5B                                    pop bx                    ; get the second number back
[2329]    161E: 58                                    pop ax                    ; get the first number back
[2330]    161F: 33 D2                                 xor dx, dx                ; clear DX before dividing
[2331]    1621: F7 F1                                 div cx                    ; AX = first / gcd
[2332]    1623: F7 E3                                 mul bx                    ; DX:AX = (first / gcd) * second = the LCM
[2333]    1625: 83 FA 00                              cmp dx, 0                 ; did it spill into DX?
[2334]    1628: 75 0C                                 jne lc_error              ; yes: too big
[2335]    162A: 3D FF 7F                              cmp ax, 7FFFh             ; too big for a signed number?
[2336]    162D: 77 07                                 ja lc_error               ; yes: error
[2337]    162F: F8                                    clc                       ; carry = 0: no error
[2338]    1630: C3                                    ret                       ; back
[2339]    1631:                                       lc_zero:
[2340]    1631: B8 00 00                              mov ax, 0                 ; LCM with 0 is 0
[2341]    1634: F8                                    clc                       ; carry = 0: no error
[2342]    1635: C3                                    ret                       ; back
[2343]    1636:                                       lc_error:
[2344]    1636: F9                                    stc                       ; carry = 1: there was an error
[2345]    1637: C3                                    ret                       ; back
[2346]        :                                       do_lcm endp
[2347]        :                                       
[2348]    1638:                                       do_mod proc                   ; AX = first mod cur. Carry flag = error
[2349]    1638: 8B 1E EA 14                           mov bx, [cur]             ; BX = the divisor
[2350]    163C: 83 FB 00                              cmp bx, 0                 ; dividing by zero?
[2351]    163F: 74 14                                 je md_error               ; yes: error
[2352]    1641: A1 EC 14                              mov ax, [first]           ; AX = the number being divided
[2353]    1644: 83 FB FF                              cmp bx, -1                ; divisor is -1?
[2354]    1647: 74 07                                 je md_zero                ; yes: the remainder is always 0 (also avoids idiv overflow)
[2355]    1649: 99                                    cwd                       ; stretch AX into DX:AX
[2356]    164A: F7 FB                                 idiv bx                   ; DX = the remainder (signed)
[2357]    164C: 8B C2                                 mov ax, dx                ; AX = the remainder
[2358]    164E: F8                                    clc                       ; carry = 0: no error
[2359]    164F: C3                                    ret                       ; back
[2360]    1650:                                       md_zero:
[2361]    1650: B8 00 00                              mov ax, 0                 ; remainder is 0
[2362]    1653: F8                                    clc                       ; carry = 0: no error
[2363]    1654: C3                                    ret                       ; back
[2364]    1655:                                       md_error:
[2365]    1655: F9                                    stc                       ; carry = 1: there was an error
[2366]    1656: C3                                    ret                       ; back
[2367]        :                                       do_mod endp
